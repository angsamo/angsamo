<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>보완·반품 상세 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace"><section class="page-heading"><div><p class="eyebrow">SP05 · RETURN</p><h1>보완·반품 상세</h1><p>반품 사유를 확인하고 보완 결과 저장 후 재출하합니다.</p></div></section><c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="panel vendor-detail"><div class="panel-header"><div><p class="vendor-code">RT-${returnItem.procurementId}</p><h2><c:out value="${returnItem.itemName}"/> <small><c:out value="${returnItem.itemCode}"/></small></h2></div><span class="vendor-status status-${returnItem.status}">${returnItem.status}</span></div><dl class="vendor-facts"><div><dt>발주 수량</dt><dd><fmt:formatNumber value="${returnItem.orderQty}"/> ${returnItem.unit}</dd></div><div><dt>정상 입고</dt><dd><fmt:formatNumber value="${returnItem.receivedQty}"/> ${returnItem.unit}</dd></div><div><dt>검수 결과</dt><dd><c:out value="${returnItem.inspectionResult}"/></dd></div><div><dt>요청 납기</dt><dd>${returnItem.requiredDate}</dd></div></dl><div class="vendor-return-reason"><strong>반품 사유·보완 이력</strong><p><c:out value="${empty returnItem.terms ? '-' : returnItem.terms}"/></p></div>
<c:if test="${canProcess and (returnItem.status eq 'RETURNED' or returnItem.status eq 'RETURN_REQUESTED')}"><form class="vendor-form" method="post" action="${pageContext.request.contextPath}/supplier/returns/${returnItem.procurementId}/supplement"><label>보완 결과<textarea name="supplement" maxlength="500" rows="4" required></textarea></label><button class="vendor-button" type="submit">보완 결과 저장</button></form></c:if><div class="vendor-detail-actions"><a class="vendor-button secondary inline-button" href="${pageContext.request.contextPath}/vendor/returns">목록</a><c:if test="${canProcess and returnItem.status eq 'RESUPPLYING'}"><form method="post" action="${pageContext.request.contextPath}/vendor/returns/${returnItem.procurementId}/reship" data-confirm="보완 완료 후 재출하하시겠습니까?"><button class="vendor-button" type="submit">재출하</button></form></c:if></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
