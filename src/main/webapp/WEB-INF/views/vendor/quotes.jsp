<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 견적 관리 | 앙사모 ERP</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">VENDOR QUOTE</p><h1>견적 관리</h1><p>내 회사에 요청된 견적만 확인하고 단가·납품 가능일·거래 조건을 제출합니다.</p></div></section><section class="notice"><span class="material-symbols-outlined">info</span><p><strong>견적 제출 안내</strong> 견적 마감일 전까지 단가, 납품 가능일과 거래 조건을 입력해 주세요.</p></section>
<c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="panel vendor-filter"><form method="get"><label>상태<select name="status"><option value="">전체</option><option value="REQUESTED" ${status eq 'REQUESTED' ? 'selected' : ''}>제출 대기</option><option value="SUBMITTED" ${status eq 'SUBMITTED' ? 'selected' : ''}>제출 완료</option><option value="SELECTED" ${status eq 'SELECTED' ? 'selected' : ''}>선정</option><option value="REJECTED" ${status eq 'REJECTED' ? 'selected' : ''}>미선정</option></select></label><button class="vendor-button secondary" type="submit">조회</button></form></section>
<section class="vendor-card-grid">
<c:forEach items="${quotes}" var="quote"><article class="panel vendor-card"><header><div><p class="vendor-code">견적 #${quote.quoteId} · 조달 #${quote.procurementId}</p><h2><c:out value="${quote.itemName}"/> <small><c:out value="${quote.itemCode}"/></small></h2></div><div class="quote-status-group"><span class="vendor-status status-${quote.status}"><c:out value="${quote.status}"/></span><c:if test="${not empty quote.selectedVendorId}"><span class="vendor-status ${quote.selected ? 'status-SELECTED' : 'status-REJECTED'}">${quote.selected ? '선정' : '미선정'}</span></c:if></div></header>
<dl class="vendor-facts"><div><dt>요청 수량</dt><dd><fmt:formatNumber value="${quote.requestQty}"/> <c:out value="${quote.unit}"/></dd></div><div><dt>필요일</dt><dd>${quote.requiredDate}</dd></div><div><dt>견적 마감</dt><dd>${quote.quoteDeadline}</dd></div><div><dt>규격</dt><dd><c:out value="${empty quote.spec ? '-' : quote.spec}"/></dd></div></dl>
<c:choose><c:when test="${quote.status eq 'REQUESTED' and canProcess}"><form class="vendor-action-form" method="post" action="${pageContext.request.contextPath}/supplier/quotes" data-confirm="이 견적을 제출하시겠습니까?"><input type="hidden" name="quoteId" value="${quote.quoteId}"><label>공급 단가<input type="number" name="unitPrice" min="0.01" step="0.01" required></label><label>납품 가능일<input type="date" name="deliveryDate" required></label><label class="wide">거래 조건<input type="text" name="terms" maxlength="500" placeholder="결제 조건, 운송 조건 등을 입력" required></label><button class="vendor-button" type="submit">견적 제출</button></form></c:when><c:when test="${quote.status eq 'REQUESTED'}"><p class="vendor-readonly">관리자는 전체 견적을 조회할 수 있으며 제출은 협력회사 계정에서만 가능합니다.</p></c:when><c:otherwise><div class="vendor-submitted"><span>제출 단가 <strong><fmt:formatNumber value="${quote.unitPrice}" pattern="#,#00.##"/></strong></span><span>납품 가능일 <strong>${quote.deliveryDate}</strong></span><span>거래 조건 <strong><c:out value="${quote.terms}"/></strong></span></div></c:otherwise></c:choose></article></c:forEach>
<c:if test="${empty quotes}"><div class="panel vendor-empty"><span class="material-symbols-outlined">request_quote</span><h2>표시할 견적 요청이 없습니다.</h2><p>구매부서에서 견적을 요청하면 이곳에 표시됩니다.</p></div></c:if></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
