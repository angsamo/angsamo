<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>검수·보완 결과 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace"><section class="page-heading"><div><p class="eyebrow">SP06 · INSPECTION</p><h1>진척 검수·보완 결과</h1><p>자재부서 검수 결과를 확인하고 반품 판정 건의 보완 결과를 등록합니다.</p></div></section>
<c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="panel vendor-detail"><div class="panel-header"><div><p class="vendor-code">검수 #${inspection.procurementId}</p><h2><c:out value="${inspection.itemName}"/> <small><c:out value="${inspection.itemCode}"/></small></h2></div><span class="vendor-status status-${inspection.status}">${inspection.status}</span></div><dl class="vendor-facts"><div><dt>발주 수량</dt><dd><fmt:formatNumber value="${inspection.orderQty}"/> ${inspection.unit}</dd></div><div><dt>납기 기준일</dt><dd>${inspection.requiredDate}</dd></div><div><dt>출하 일시</dt><dd>${inspection.shippedAt}</dd></div><div><dt>입고 수량</dt><dd><fmt:formatNumber value="${inspection.receivedQty}"/> ${inspection.unit}</dd></div><div><dt>검수 결과</dt><dd><c:out value="${empty inspection.inspectionResult ? '검수 대기' : inspection.inspectionResult}"/></dd></div><div><dt>검수·입고 일시</dt><dd>${inspection.receivedAt}</dd></div></dl><div class="vendor-return-reason"><strong>검수 및 보완 이력</strong><p><c:out value="${empty inspection.terms ? '-' : inspection.terms}"/></p></div>
<c:if test="${canProcess and (inspection.status eq 'RETURNED' or inspection.status eq 'RETURN_REQUESTED')}"><form class="vendor-form" method="post" action="${pageContext.request.contextPath}/supplier/inspections/${inspection.procurementId}"><label>보완 결과<textarea name="supplement" maxlength="500" rows="4" required placeholder="원인 분석과 보완 조치 내용을 입력하세요."></textarea></label><div class="vendor-detail-actions"><button class="vendor-button" type="submit">보완 결과 등록</button></div></form></c:if>
<div class="vendor-detail-actions"><a class="vendor-button secondary inline-button" href="${pageContext.request.contextPath}/vendor/inspections">목록</a><c:if test="${inspection.status eq 'RETURNED' or inspection.status eq 'RETURN_REQUESTED' or inspection.status eq 'RESUPPLYING'}"><a class="vendor-button inline-button" href="${pageContext.request.contextPath}/vendor/returns/${inspection.procurementId}">보완·반품 상세</a></c:if></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
