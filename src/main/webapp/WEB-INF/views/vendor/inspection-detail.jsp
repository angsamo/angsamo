<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>검사·보완 결과 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">INSPECTION RESULT</p><h1>검사·보완 결과 조회</h1><p>자재부서가 등록한 내 회사 출하 건의 검사 결과와 반품 여부를 확인합니다.</p></div></section>
<section class="notice"><span class="material-symbols-outlined">info</span><p><strong>조회 전용 정보</strong> 입고 수량과 검사 결과는 자재부서가 관리하며 협력회사에서는 변경할 수 없습니다.</p></section>
<section class="panel vendor-detail"><div class="panel-header"><div><p class="vendor-code">검사 #${inspection.procurementId}</p><h2><c:out value="${inspection.itemName}"/> <small><c:out value="${inspection.itemCode}"/></small></h2></div><span class="vendor-status status-${inspection.status}">${inspection.status}</span></div>
<dl class="vendor-facts"><div><dt>발주 수량</dt><dd><fmt:formatNumber value="${inspection.orderQty}"/> ${inspection.unit}</dd></div><div><dt>납기 기준일</dt><dd>${inspection.requiredDate}</dd></div><div><dt>출하 일시</dt><dd>${inspection.shippedAt}</dd></div><div><dt>입고 수량</dt><dd><fmt:formatNumber value="${inspection.receivedQty}"/> ${inspection.unit}</dd></div><div><dt>검사 결과</dt><dd><c:out value="${empty inspection.inspectionResult ? '검사 대기' : inspection.inspectionResult}"/></dd></div><div><dt>검사·입고 일시</dt><dd>${inspection.receivedAt}</dd></div></dl>
<div class="vendor-return-reason"><strong>반품·보완 안내</strong><p><c:choose><c:when test="${inspection.status eq 'RETURNED' or inspection.status eq 'RETURN_REQUESTED' or inspection.status eq 'RESUPPLYING'}">보완 및 재출하는 보완·반품 메뉴에서 처리해 주세요.</c:when><c:otherwise>자재부서의 검사 결과를 확인해 주세요.</c:otherwise></c:choose></p></div>
<div class="vendor-detail-actions"><a class="vendor-button secondary inline-button" href="${pageContext.request.contextPath}/vendor/inspections">목록</a><c:if test="${inspection.status eq 'RETURNED' or inspection.status eq 'RETURN_REQUESTED' or inspection.status eq 'RESUPPLYING'}"><a class="vendor-button inline-button" href="${pageContext.request.contextPath}/vendor/returns">보완·반품 확인</a></c:if></div>
</section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
