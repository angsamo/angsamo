<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 발주 관리 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">PURCHASE ORDER</p><h1>발주 관리</h1><p>구매부서에서 확정한 내 회사 발주를 확인하고 제작을 시작합니다.</p></div></section>
<section class="notice"><span class="material-symbols-outlined">info</span><p><strong>발주 확인 안내</strong> 품목, 수량, 단가, 납기와 거래 조건을 확인한 후 발주 확인을 눌러 주세요.</p></section>
<c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="panel table-panel"><div class="panel-header"><h2>확인 대기 발주</h2><span>${orders.size()}건</span></div><div class="table-scroll"><table class="data-table vendor-table"><thead><tr><th>발주</th><th>품목</th><th>수량</th><th>단가</th><th>납기</th><th>거래 조건</th><th>상태</th><th>처리</th></tr></thead><tbody>
<c:forEach items="${orders}" var="order"><tr><td>PO-${order.procurementId}<br><small><c:out value="${order.vendorName}"/></small></td><td><strong><c:out value="${order.itemName}"/></strong><br><small><c:out value="${order.itemCode}"/> · <c:out value="${order.spec}"/></small></td><td><fmt:formatNumber value="${order.orderQty}"/> <c:out value="${order.unit}"/></td><td><fmt:formatNumber value="${order.unitPrice}" pattern="#,#00.##"/></td><td>${order.requiredDate}</td><td><c:out value="${empty order.terms ? '-' : order.terms}"/></td><td><span class="vendor-status status-${order.status}">발주 확인 대기</span></td><td><c:choose><c:when test="${canProcess}"><form method="post" action="${pageContext.request.contextPath}/supplier/orders" data-confirm="발주를 확인하고 제작을 시작하시겠습니까?"><input type="hidden" name="procurementId" value="${order.procurementId}"><button class="vendor-button compact" type="submit">발주 확인</button></form></c:when><c:otherwise><span class="vendor-muted">조회 전용</span></c:otherwise></c:choose></td></tr></c:forEach>
<c:if test="${empty orders}"><tr><td colspan="8" class="empty-cell">확인 대기 중인 발주가 없습니다.</td></tr></c:if></tbody></table></div></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
