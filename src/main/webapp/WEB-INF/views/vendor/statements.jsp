<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 거래명세 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace"><section class="page-heading"><div><p class="eyebrow">TRANSACTION STATEMENT</p><h1>거래명세 조회</h1><p>입고 완료된 내 회사 조달 내역을 기준으로 거래 금액을 조회합니다.</p></div></section><section class="notice"><span class="material-symbols-outlined">info</span><p><strong>거래명세 기준</strong> 입고 검수가 완료된 발주 내역만 거래명세에 표시됩니다.</p></section>
<section class="panel table-panel"><div class="panel-header"><h2>입고 완료 거래 내역</h2><span>${statements.size()}건</span></div><div class="table-scroll"><table class="data-table vendor-table"><thead><tr><th>거래번호</th><th>협력회사</th><th>품목</th><th>입고 수량</th><th>공급 단가</th><th>공급 금액</th><th>입고 일시</th><th>상태</th><th>상세</th></tr></thead><tbody><c:forEach items="${statements}" var="row"><tr><td>TS-${row.procurementId}</td><td><c:out value="${row.vendorName}"/></td><td><strong><c:out value="${row.itemName}"/></strong><br><small><c:out value="${row.itemCode}"/></small></td><td><fmt:formatNumber value="${row.receivedQty}"/> ${row.unit}</td><td><fmt:formatNumber value="${row.unitPrice}" pattern="#,#00.##"/></td><td><fmt:formatNumber value="${row.receivedQty * row.unitPrice}" pattern="#,#00.##"/></td><td>${row.receivedAt}</td><td><span class="vendor-status status-${row.status}">${row.status}</span></td><td><a class="vendor-button compact inline-button" href="${pageContext.request.contextPath}/supplier/orders/${row.procurementId}/statement">조회</a></td></tr></c:forEach><c:if test="${empty statements}"><tr><td colspan="9" class="empty-cell">입고 완료된 거래 내역이 없습니다.</td></tr></c:if></tbody></table></div></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
