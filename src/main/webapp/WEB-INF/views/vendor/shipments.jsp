<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 제작·출하 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">PRODUCTION &amp; SHIPPING</p><h1>제작·출하 관리</h1><p>발주 확인이 완료된 품목의 제작 진행 상태를 확인하고 출하를 등록합니다.</p></div></section>
<section class="notice"><span class="material-symbols-outlined">info</span><p><strong>제작·출하 안내</strong> 제작 중인 발주만 출하할 수 있으며, 출하 완료 내역도 상태별로 조회할 수 있습니다.</p></section>
<c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="panel vendor-filter"><form method="get"><label>진행 상태<select name="status"><option value="IN_PROGRESS" ${status eq 'IN_PROGRESS' ? 'selected' : ''}>제작 중</option><option value="SHIPPED" ${status eq 'SHIPPED' ? 'selected' : ''}>출하 완료</option><option value="RECEIVED" ${status eq 'RECEIVED' ? 'selected' : ''}>입고 완료</option></select></label><button class="vendor-button secondary" type="submit">조회</button></form></section>
<section class="panel table-panel"><div class="panel-header"><h2>제작·출하 진행 목록</h2><span>${orders.size()}건</span></div><div class="table-scroll"><table class="data-table vendor-table"><thead><tr><th>발주</th><th>품목</th><th>제작·출하 수량</th><th>납기</th><th>거래 조건</th><th>진행 상태</th><th>처리</th></tr></thead><tbody>
<c:forEach items="${orders}" var="order"><tr><td>PO-${order.procurementId}<br><small><c:out value="${order.vendorName}"/></small></td><td><strong><c:out value="${order.itemName}"/></strong><br><small><c:out value="${order.itemCode}"/> · <c:out value="${order.spec}"/></small></td><td><fmt:formatNumber value="${order.orderQty}"/> <c:out value="${order.unit}"/></td><td>${order.requiredDate}</td><td><c:out value="${empty order.terms ? '-' : order.terms}"/></td><td><span class="vendor-status status-${order.status}"><c:choose><c:when test="${order.status eq 'IN_PROGRESS'}">제작 중</c:when><c:when test="${order.status eq 'SHIPPED'}">출하 완료</c:when><c:otherwise>입고 완료</c:otherwise></c:choose></span></td><td><c:choose><c:when test="${order.status eq 'IN_PROGRESS' and canProcess}"><a class="vendor-button compact inline-button" href="${pageContext.request.contextPath}/supplier/orders/${order.procurementId}/shipment">출하 등록</a></c:when><c:otherwise><span class="vendor-muted">처리 완료</span></c:otherwise></c:choose></td></tr></c:forEach>
<c:if test="${empty orders}"><tr><td colspan="7" class="empty-cell">선택한 상태의 제작·출하 내역이 없습니다.</td></tr></c:if></tbody></table></div></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
