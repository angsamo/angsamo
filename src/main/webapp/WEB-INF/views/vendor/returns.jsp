<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 보완·반품 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace"><section class="page-heading"><div><p class="eyebrow">RETURN &amp; SUPPLEMENT</p><h1>보완·반품 관리</h1><p>내 회사 납품 건의 불합격 결과를 확인하고 보완 후 재출하합니다.</p></div></section><section class="notice"><span class="material-symbols-outlined">info</span><p><strong>보완 처리 안내</strong> 검사 결과와 반품 사유를 확인한 후 보완 완료·재출하를 진행해 주세요.</p></section>
<c:if test="${not empty success}"><div class="vendor-flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="vendor-flash error"><c:out value="${error}"/></div></c:if>
<section class="vendor-card-grid"><c:forEach items="${returns}" var="row"><article class="panel vendor-card return-card"><header><div><p class="vendor-code">반품 조달 #${row.procurementId}</p><h2><c:out value="${row.itemName}"/> <small><c:out value="${row.itemCode}"/></small></h2></div><span class="vendor-status status-${row.status}">${row.status}</span></header><dl class="vendor-facts"><div><dt>발주 수량</dt><dd><fmt:formatNumber value="${row.orderQty}"/> ${row.unit}</dd></div><div><dt>정상 입고</dt><dd><fmt:formatNumber value="${row.receivedQty}"/> ${row.unit}</dd></div><div><dt>검사 결과</dt><dd><c:out value="${row.inspectionResult}"/></dd></div><div><dt>검사 일시</dt><dd>${row.receivedAt}</dd></div></dl><div class="vendor-return-reason"><strong>반품·보완 사유</strong><p><c:out value="${empty row.terms ? '자재부서 검사 결과를 확인해 주세요.' : row.terms}"/></p></div><c:if test="${canProcess and (row.status eq 'RETURNED' or row.status eq 'RETURN_REQUESTED' or row.status eq 'RESUPPLYING')}"><form method="post" action="${pageContext.request.contextPath}/vendor/returns/${row.procurementId}/reship" data-confirm="보완 완료 후 재출하하시겠습니까?"><button class="vendor-button" type="submit">보완 완료·재출하</button></form></c:if></article></c:forEach><c:if test="${empty returns}"><div class="panel vendor-empty"><span class="material-symbols-outlined">assignment_turned_in</span><h2>보완 대상이 없습니다.</h2><p>검사 불합격 또는 반품 요청 건이 이곳에 표시됩니다.</p></div></c:if></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
