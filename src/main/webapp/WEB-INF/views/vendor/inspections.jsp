<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>협력회사 검사 결과 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace"><section class="page-heading"><div><p class="eyebrow">INSPECTION</p><h1>검사 결과</h1><p>출하한 품목의 자재부서 검사 결과와 입고 수량을 조회합니다.</p></div></section><section class="notice"><span class="material-symbols-outlined">info</span><p><strong>검사 결과 조회</strong> 다른 협력회사의 검사 정보는 표시되지 않습니다.</p></section>
<section class="panel table-panel"><div class="panel-header"><h2>검사·입고 진행 현황</h2><span>${inspections.size()}건</span></div><div class="table-scroll"><table class="data-table vendor-table"><thead><tr><th>발주</th><th>품목</th><th>출하 수량</th><th>입고 수량</th><th>검사 결과</th><th>출하 일시</th><th>입고 일시</th><th>상태</th><th>상세</th></tr></thead><tbody><c:forEach items="${inspections}" var="row"><tr><td>PO-${row.procurementId}</td><td><strong><c:out value="${row.itemName}"/></strong><br><small><c:out value="${row.itemCode}"/></small></td><td><fmt:formatNumber value="${row.orderQty}"/> ${row.unit}</td><td><fmt:formatNumber value="${row.receivedQty}"/> ${row.unit}</td><td><c:out value="${empty row.inspectionResult ? '검사 대기' : row.inspectionResult}"/></td><td>${row.shippedAt}</td><td>${row.receivedAt}</td><td><span class="vendor-status status-${row.status}">${row.status}</span></td><td><a class="vendor-button compact inline-button" href="${pageContext.request.contextPath}/supplier/inspections/${row.procurementId}">확인</a></td></tr></c:forEach><c:if test="${empty inspections}"><tr><td colspan="9" class="empty-cell">검사 대상 출하 건이 없습니다.</td></tr></c:if></tbody></table></div></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
