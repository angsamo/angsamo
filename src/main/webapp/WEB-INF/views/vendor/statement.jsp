<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>거래명세 조회 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">TRANSACTION STATEMENT</p><h1>거래명세 조회</h1><p>자재부서의 입고 완료 정보를 기준으로 내 회사 거래 내역을 조회합니다.</p></div></section>
<section class="notice"><span class="material-symbols-outlined">info</span><p><strong>조회 전용 정보</strong> 거래명세 발행과 입고 확인은 자재부서가 담당하며 협력회사에서는 내용을 변경할 수 없습니다.</p></section>
<section class="panel vendor-statement"><header><div><p class="vendor-code">TRANSACTION STATEMENT</p><h2>TS-${statement.procurementId}</h2></div><span class="vendor-status status-${statement.status}">${statement.status}</span></header><div class="statement-parties"><div><span>공급자</span><strong><c:out value="${statement.vendorName}"/></strong></div><div><span>공급받는 자</span><strong>앙사모 ERP</strong></div></div>
<div class="table-scroll"><table class="data-table"><thead><tr><th>품목코드</th><th>품목명</th><th>규격</th><th>입고 수량</th><th>단가</th><th>공급금액</th></tr></thead><tbody><tr><td><c:out value="${statement.itemCode}"/></td><td><c:out value="${statement.itemName}"/></td><td><c:out value="${statement.spec}"/></td><td><fmt:formatNumber value="${statement.receivedQty}"/> ${statement.unit}</td><td><fmt:formatNumber value="${statement.unitPrice}" pattern="#,#00.##"/></td><td><fmt:formatNumber value="${statement.receivedQty * statement.unitPrice}" pattern="#,#00.##"/></td></tr></tbody></table></div>
<dl class="vendor-facts"><div><dt>발주일</dt><dd>${statement.orderedAt}</dd></div><div><dt>입고일</dt><dd>${statement.receivedAt}</dd></div><div><dt>거래 조건</dt><dd><c:out value="${empty statement.terms ? '-' : statement.terms}"/></dd></div><div><dt>검사 결과</dt><dd><c:out value="${statement.inspectionResult}"/></dd></div></dl><div class="vendor-detail-actions"><a class="vendor-button secondary inline-button" href="${pageContext.request.contextPath}/vendor/statements">목록</a><c:if test="${canProcess and statement.status eq 'RECEIVED'}"><form method="post" action="${pageContext.request.contextPath}/supplier/orders/${statement.procurementId}/statement" data-confirm="표시된 입고 내역으로 거래명세서를 등록하시겠습니까?"><button class="vendor-button" type="submit">거래명세서 등록</button></form></c:if></div>
</section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
