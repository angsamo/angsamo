<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>출하 등록 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/vendor.css"></head><body>
<jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace vendor-workspace">
<section class="page-heading"><div><p class="eyebrow">SP03 · SHIPMENT</p><h1>제작 완료·출하 등록</h1><p>발주 수량과 납기일을 확인한 후 제작 중인 품목을 출하 처리합니다.</p></div></section>
<section class="panel vendor-detail"><div class="panel-header"><div><p class="vendor-code">PO-${order.procurementId}</p><h2><c:out value="${order.itemName}"/> <small><c:out value="${order.itemCode}"/></small></h2></div><span class="vendor-status status-${order.status}">${order.status}</span></div><dl class="vendor-facts"><div><dt>협력회사</dt><dd><c:out value="${order.vendorName}"/></dd></div><div><dt>출하 수량</dt><dd><fmt:formatNumber value="${order.orderQty}"/> ${order.unit}</dd></div><div><dt>도착 예정일</dt><dd>${order.requiredDate}</dd></div><div><dt>거래 조건</dt><dd><c:out value="${empty order.terms ? '-' : order.terms}"/></dd></div></dl><div class="vendor-detail-actions"><a class="vendor-button secondary inline-button" href="${pageContext.request.contextPath}/vendor/shipments">목록</a><c:if test="${canProcess and order.status eq 'IN_PROGRESS'}"><form method="post" action="${pageContext.request.contextPath}/supplier/orders/${order.procurementId}/shipment" data-confirm="발주 수량 전체를 출하 처리하시겠습니까?"><button class="vendor-button" type="submit">출하 등록</button></form></c:if></div></section>
</main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/vendor.js"></script></body></html>
