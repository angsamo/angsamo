<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="${post.title}" scope="request"/>
<c:set var="breadcrumb" value="관리자 / 게시글 관리 / 상세" scope="request"/>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>게시글 상세 | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">POST DETAIL</p><h1><c:out value="${post.title}"/></h1><p><c:out value="${post.boardName}"/> · <c:out value="${post.authorName}"/></p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/posts">목록으로</a></section>
<c:if test="${not empty success}"><div class="notice">${success}</div></c:if><c:if test="${not empty error}"><div class="notice error-notice">${error}</div></c:if>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">EDIT POST</p><h2>게시글 수정</h2></div></div><form class="detail-form" method="post" action="${pageContext.request.contextPath}/admin/posts/${post.postId}"><label>제목<input name="title" value="<c:out value='${post.title}'/>" required></label><label>내용<textarea name="content" rows="6" required><c:out value="${post.content}"/></textarea></label><button class="primary-button" type="submit">수정</button></form><div class="detail-meta">상태: ${post.active ? '사용' : '중지'} · 조회수: ${post.viewCount} · 작성일: <c:out value="${post.createdAt}"/></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
