<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>&#54801;&#47141;&#54924;&#49324; &#44288;&#47532; | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">ADMIN</p><h1>&#54801;&#47141;&#54924;&#49324; &#44288;&#47532;</h1><p>&#54801;&#47141;&#54924;&#49324; &#53076;&#46300;&#50752; &#54924;&#49324;&#47749;&#51012; &#44288;&#47532;&#54633;&#45768;&#45796;.</p></div></section><c:if test="${not empty success}"><div class="notice">${success}</div></c:if><c:if test="${not empty error}"><div class="notice error-notice">${error}</div></c:if>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">NEW VENDOR</p><h2>&#54801;&#47141;&#54924;&#49324; &#46321;&#47197;</h2></div></div><form class="admin-user-form department-form" method="post" action="${pageContext.request.contextPath}/admin/vendors"><input name="vendorId" placeholder="VENDOR_CODE" pattern="[A-Za-z0-9_-]+" required><input name="vendorName" placeholder="&#54801;&#47141;&#54924;&#49324;&#47749;" required><button class="primary-button" type="submit">&#46321;&#47197;</button></form></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">VENDOR LIST</p><h2>&#51204;&#52404; &#54801;&#47141;&#54924;&#49324;</h2></div><input class="table-search" data-table-search="vendor-table" placeholder="&#53076;&#46300;, &#54924;&#49324;&#47749; &#44160;&#49353;"></div><div class="table-scroll"><table class="data-table" id="vendor-table"><thead><tr><th>&#53076;&#46300;</th><th>&#54924;&#49324;&#47749;</th><th>&#46321;&#47197;&#51068;</th><th>&#44288;&#47532;</th></tr></thead><tbody><c:forEach var="vendor" items="${vendors}"><tr><td><a href="${pageContext.request.contextPath}/admin/vendors/${vendor.vendorId}"><c:out value="${vendor.vendorId}"/></a></td><td><input form="vendor-${vendor.vendorId}" name="vendorName" value="<c:out value='${vendor.vendorName}'/>" required></td><td><c:out value="${vendor.createdAt}"/></td><td class="row-actions"><a class="text-button detail-link" href="${pageContext.request.contextPath}/admin/vendors/${vendor.vendorId}">&#49345;&#49464;&#48372;&#44592;</a><form id="vendor-${vendor.vendorId}" method="post" action="${pageContext.request.contextPath}/admin/vendors/${vendor.vendorId}"><button class="text-button" type="submit">&#49688;&#51221;</button></form></td></tr></c:forEach><c:if test="${empty vendors}"><tr><td class="empty-cell" colspan="4">&#46321;&#47197;&#46108; &#54801;&#47141;&#54924;&#49324;&#44032; &#50630;&#49845;&#45768;&#45796;.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/admin-filter.js"></script></body></html>
