<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>&#48512;&#49436; &#44288;&#47532; | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">ADMIN</p><h1>&#48512;&#49436; &#44288;&#47532;</h1><p>&#48512;&#49436;&#47484; &#46321;&#47197;&#54616;&#44256; &#53076;&#46300;, &#51060;&#47492;, &#49345;&#53468;&#47484; &#44288;&#47532;&#54633;&#45768;&#45796;.</p></div></section>
<c:if test="${not empty success}"><div class="notice">${success}</div></c:if><c:if test="${not empty error}"><div class="notice error-notice">${error}</div></c:if>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">NEW DEPARTMENT</p><h2>&#48512;&#49436; &#46321;&#47197;</h2></div></div><form class="admin-user-form department-form" method="post" action="${pageContext.request.contextPath}/admin/departments"><input name="departmentCode" placeholder="DEPARTMENT_CODE" pattern="[A-Za-z][A-Za-z0-9_]*" required><input name="departmentName" placeholder="&#48512;&#49436;&#47749;" required><button class="primary-button" type="submit">&#46321;&#47197;</button></form></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">DEPARTMENT LIST</p><h2>&#51204;&#52404; &#48512;&#49436;</h2></div><input class="table-search" data-table-search="department-table" placeholder="&#53076;&#46300;, &#48512;&#49436;&#47749; &#44160;&#49353;"></div><div class="table-scroll"><table class="data-table" id="department-table"><thead><tr><th>ID</th><th>&#48512;&#49436; &#53076;&#46300;</th><th>&#48512;&#49436;&#47749;</th><th>&#49345;&#53468;</th><th>&#46321;&#47197;&#51068;</th><th>&#44288;&#47532;</th></tr></thead><tbody>
<c:forEach var="department" items="${departments}"><tr><td>${department.departmentId}</td><td><input form="department-${department.departmentId}" name="departmentCode" value="<c:out value='${department.departmentCode}'/>" required></td><td><input form="department-${department.departmentId}" name="departmentName" value="<c:out value='${department.departmentName}'/>" required></td><td><select form="department-${department.departmentId}" name="active"><option value="true" ${department.active ? 'selected' : ''}>&#49324;&#50857;</option><option value="false" ${not department.active ? 'selected' : ''}>&#51473;&#51648;</option></select></td><td><c:out value="${department.createdAt}"/></td><td class="row-actions"><a class="text-button detail-link" href="${pageContext.request.contextPath}/admin/departments/${department.departmentId}">&#49345;&#49464;&#48372;&#44592;</a><form id="department-${department.departmentId}" method="post" action="${pageContext.request.contextPath}/admin/departments/${department.departmentId}"><button class="text-button" type="submit">&#49688;&#51221;</button></form><form method="post" action="${pageContext.request.contextPath}/admin/departments/${department.departmentId}/deactivate"><button class="text-button danger" type="submit">&#48708;&#54876;&#49457;&#54868;</button></form></td></tr></c:forEach>
<c:if test="${empty departments}"><tr><td class="empty-cell" colspan="6">&#46321;&#47197;&#46108; &#48512;&#49436;&#44032; &#50630;&#49845;&#45768;&#45796;.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/admin-filter.js"></script></body></html>
