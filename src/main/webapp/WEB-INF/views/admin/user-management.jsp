<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>&#49324;&#50857;&#51088; &#44288;&#47532; | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">ADMIN</p><h1>&#49324;&#50857;&#51088; &#44288;&#47532;</h1><p>&#44228;&#51221;&#51012; &#46321;&#47197;&#54616;&#44256; &#49548;&#49549;, &#44428;&#54620;, &#49345;&#53468;&#47484; &#44288;&#47532;&#54633;&#45768;&#45796;.</p></div></section>
<c:if test="${not empty success}"><div class="notice">${success}</div></c:if><c:if test="${not empty error}"><div class="notice error-notice">${error}</div></c:if>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">NEW USER</p><h2>&#49324;&#50857;&#51088; &#46321;&#47197;</h2></div></div><form class="admin-user-form" method="post" action="${pageContext.request.contextPath}/admin/users"><input name="loginId" placeholder="&#47196;&#44536;&#51064; &#50500;&#51060;&#46356;" required><input type="password" name="password" placeholder="&#48708;&#48128;&#48264;&#54840;" required><input name="userName" placeholder="&#51060;&#47492;" required><select name="departmentId"><option value="">&#48512;&#49436; &#50630;&#51020;</option><c:forEach var="department" items="${departments}"><c:if test="${department.active}"><option value="${department.departmentId}"><c:out value="${department.departmentName}"/></option></c:if></c:forEach></select><select name="vendorId"><option value="">&#xD611;&#xB825;&#xD68C;&#xC0AC; &#xC5C6;&#xC74C;</option><c:forEach var="vendor" items="${vendors}"><option value="${vendor.vendorId}"><c:out value="${vendor.vendorName}"/></option></c:forEach></select><select name="role"><option value="MEMBER">MEMBER</option><option value="ADMIN">ADMIN</option></select><button class="primary-button" type="submit">&#46321;&#47197;</button></form></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">USER LIST</p><h2>&#51204;&#52404; &#49324;&#50857;&#51088;</h2></div><input class="table-search" data-table-search="user-table" placeholder="&#xC544;&#xC774;&#xB514;, &#xC774;&#xB984;, &#xBD80;&#xC11C; &#xAC80;&#xC0C9;"></div><div class="table-scroll"><table class="data-table" id="user-table"><thead><tr><th>ID</th><th>&#50500;&#51060;&#46356;</th><th>&#51060;&#47492;</th><th>&#48512;&#49436;</th><th>&#xD611;&#xB825;&#xD68C;&#xC0AC;</th><th>&#44428;&#54620;</th><th>&#49345;&#53468;</th><th>&#48708;&#48128;&#48264;&#54840;</th><th>&#44288;&#47532;</th></tr></thead><tbody>
<c:forEach var="user" items="${users}"><tr><td>${user.userId}</td><td><c:out value="${user.loginId}"/></td><td><input form="user-${user.userId}" name="userName" value="<c:out value='${user.userName}'/>" required></td><td><select form="user-${user.userId}" name="departmentId"><option value="">&#48512;&#49436; &#50630;&#51020;</option><c:forEach var="department" items="${departments}"><option value="${department.departmentId}" ${user.departmentId == department.departmentId ? 'selected' : ''}><c:out value="${department.departmentName}"/></option></c:forEach></select></td><td><select form="user-${user.userId}" name="vendorId"><option value="">&#xC5C6;&#xC74C;</option><c:forEach var="vendor" items="${vendors}"><option value="${vendor.vendorId}" ${user.vendorId == vendor.vendorId ? 'selected' : ''}><c:out value="${vendor.vendorName}"/></option></c:forEach></select></td><td><select form="user-${user.userId}" name="role"><option value="MEMBER" ${user.role == 'MEMBER' ? 'selected' : ''}>MEMBER</option><option value="ADMIN" ${user.role == 'ADMIN' ? 'selected' : ''}>ADMIN</option></select></td><td><select form="user-${user.userId}" name="active"><option value="true" ${user.active ? 'selected' : ''}>&#49324;&#50857;</option><option value="false" ${not user.active ? 'selected' : ''}>&#51473;&#51648;</option></select></td><td><input form="user-${user.userId}" type="password" name="password" placeholder="&#50976;&#51648;"></td><td class="row-actions"><a class="text-button detail-link" href="${pageContext.request.contextPath}/admin/users/${user.userId}">&#49345;&#49464;&#48372;&#44592;</a><form id="user-${user.userId}" method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}"><button class="text-button" type="submit">&#49688;&#51221;</button></form><form method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}/deactivate"><button class="text-button danger" type="submit">&#48708;&#54876;&#49457;&#54868;</button></form></td></tr></c:forEach>
<c:if test="${empty users}"><tr><td class="empty-cell" colspan="9">&#46321;&#47197;&#46108; &#49324;&#50857;&#51088;&#44032; &#50630;&#49845;&#45768;&#45796;.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script><script src="${pageContext.request.contextPath}/resources/js/admin-filter.js"></script></body></html>
