<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>&#49324;&#50857;&#51088; &#49345;&#49464; | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">USER DETAIL</p><h1><c:out value="${user.userName}"/></h1><p><c:out value="${user.loginId}"/> &#44228;&#51221;&#51032; &#49345;&#49464; &#51221;&#48372;&#51077;&#45768;&#45796;.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/users">&#47785;&#47197;&#51004;&#47196;</a></section>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">ACCOUNT INFO</p><h2>&#44228;&#51221; &#51221;&#48372;</h2></div></div><form class="detail-form" method="post" action="${pageContext.request.contextPath}/admin/users/${user.userId}"><label>&#47196;&#44536;&#51064; &#50500;&#51060;&#46356;<input value="<c:out value='${user.loginId}'/>" disabled></label><label>&#51060;&#47492;<input name="userName" value="<c:out value='${user.userName}'/>" required></label><label>&#48512;&#49436;<select name="departmentId"><option value="">&#50630;&#51020;</option><c:forEach var="department" items="${departments}"><option value="${department.departmentId}" ${user.departmentId == department.departmentId ? 'selected' : ''}><c:out value="${department.departmentName}"/></option></c:forEach></select></label><label>&#54801;&#47141;&#54924;&#49324;<select name="vendorId"><option value="">&#50630;&#51020;</option><c:forEach var="vendor" items="${vendors}"><option value="${vendor.vendorId}" ${user.vendorId == vendor.vendorId ? 'selected' : ''}><c:out value="${vendor.vendorName}"/></option></c:forEach></select></label><label>&#44428;&#54620;<select name="role"><option value="MEMBER" ${user.role == 'MEMBER' ? 'selected' : ''}>MEMBER</option><option value="ADMIN" ${user.role == 'ADMIN' ? 'selected' : ''}>ADMIN</option><option value="VENDOR" ${user.role == 'VENDOR' ? 'selected' : ''}>VENDOR</option></select></label><label>&#49345;&#53468;<select name="active"><option value="true" ${user.active ? 'selected' : ''}>&#49324;&#50857;</option><option value="false" ${not user.active ? 'selected' : ''}>&#51473;&#51648;</option></select></label><label>&#49352; &#48708;&#48128;&#48264;&#54840;<input type="password" name="password" placeholder="&#48320;&#44221;&#54624; &#46412;&#47564; &#51077;&#47141;"></label><button class="primary-button" type="submit">&#49688;&#51221;</button></form><div class="detail-meta">&#46321;&#47197;&#51068;: <c:out value="${user.createdAt}"/></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
