<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="${department.departmentName}" scope="request"/>
<c:set var="breadcrumb" value="관리자 / 부서 관리 / 상세" scope="request"/>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>&#48512;&#49436; &#49345;&#49464; | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">DEPARTMENT DETAIL</p><h1><c:out value="${department.departmentName}"/></h1><p>&#48512;&#49436; &#51221;&#48372;&#50752; &#49548;&#49549; &#49324;&#50857;&#51088;&#47484; &#54869;&#51064;&#54633;&#45768;&#45796;.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/departments">&#47785;&#47197;&#51004;&#47196;</a></section>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">BASIC INFO</p><h2>&#44592;&#48376; &#51221;&#48372;</h2></div></div><form class="detail-form" method="post" action="${pageContext.request.contextPath}/admin/departments/${department.departmentId}"><label>&#48512;&#49436; &#53076;&#46300;<input value="<c:out value='${department.departmentCode}'/>" disabled></label><label>&#48512;&#49436;&#47749;<input name="departmentName" value="<c:out value='${department.departmentName}'/>" required></label><label>&#49345;&#53468;<select name="active"><option value="true" ${department.active ? 'selected' : ''}>&#49324;&#50857;</option><option value="false" ${not department.active ? 'selected' : ''}>&#51473;&#51648;</option></select></label><button class="primary-button" type="submit">&#49688;&#51221;</button></form><div class="detail-meta">&#46321;&#47197;&#51068;: <c:out value="${department.createdAt}"/></div></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">MEMBERS</p><h2>&#49548;&#49549; &#49324;&#50857;&#51088;</h2></div><span class="list-count">${users.size()}&#47749;</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>ID</th><th>&#47196;&#44536;&#51064; &#50500;&#51060;&#46356;</th><th>&#51060;&#47492;</th><th>&#44428;&#54620;</th><th>&#49345;&#53468;</th></tr></thead><tbody><c:forEach var="user" items="${users}"><tr><td>${user.userId}</td><td><a href="${pageContext.request.contextPath}/admin/users/${user.userId}"><c:out value="${user.loginId}"/></a></td><td><c:out value="${user.userName}"/></td><td><c:out value="${user.role}"/></td><td>${user.active ? '&#49324;&#50857;' : '&#51473;&#51648;'}</td></tr></c:forEach><c:if test="${empty users}"><tr><td class="empty-cell" colspan="5">&#49548;&#49549; &#49324;&#50857;&#51088;&#44032; &#50630;&#49845;&#45768;&#45796;.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
