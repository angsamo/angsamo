<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="pageTitle" value="${department.departmentName}" scope="request"/>
<c:set var="breadcrumb" value="관리자 / 부서 관리 / 상세" scope="request"/>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>부서 상세 | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">DEPARTMENT DETAIL</p><h1><c:out value="${department.departmentName}"/></h1><p>부서 정보와 소속 사용자를 확인합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/departments">목록으로</a></section>
<c:if test="${not empty success}"><div class="notice">${success}</div></c:if><c:if test="${not empty error}"><div class="notice error-notice">${error}</div></c:if>
<section class="panel admin-form-panel"><div class="panel-header"><div><p class="eyebrow">BASIC INFO</p><h2>기본 정보</h2></div></div><form class="detail-form" method="post" action="${pageContext.request.contextPath}/admin/departments/${department.departmentId}"><label>부서 코드<input value="<c:out value='${department.departmentCode}'/>" disabled></label><label>부서명<input name="departmentName" value="<c:out value='${department.departmentName}'/>" required></label><label>상태<select name="active"><option value="true" ${department.active ? 'selected' : ''}>사용</option><option value="false" ${not department.active ? 'selected' : ''}>정지</option></select></label><button class="primary-button" type="submit">수정</button></form><div class="detail-meta">등록일: <c:out value="${fn:substringBefore(department.createdAt, 'T')}"/></div></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">MEMBERS</p><h2>소속 사용자</h2></div><span class="list-count">${users.size()}명</span></div><div class="table-scroll"><table class="data-table admin-table"><thead><tr><th>ID</th><th>로그인 아이디</th><th>이름</th><th>권한</th><th>상태</th><th>부서 이동</th></tr></thead><tbody><c:forEach var="user" items="${users}"><tr><td>${user.userId}</td><td><a href="${pageContext.request.contextPath}/admin/users/${user.userId}"><c:out value="${user.loginId}"/></a></td><td><c:out value="${user.userName}"/></td><td><c:out value="${user.role}"/></td><td>${user.active ? '사용' : '정지'}</td><td><form method="post" action="${pageContext.request.contextPath}/admin/departments/${department.departmentId}/members/${user.userId}/move" class="row-actions"><select name="targetDepartmentId"><c:forEach var="d" items="${departments}"><c:if test="${d.departmentId != department.departmentId}"><option value="${d.departmentId}"><c:out value="${d.departmentName}"/></option></c:if></c:forEach></select><button class="icon-btn" type="submit" title="선택한 부서로 이동"><span class="material-symbols-outlined">move_up</span></button></form></td></tr></c:forEach><c:if test="${empty users}"><tr><td class="empty-cell" colspan="6">소속 사용자가 없습니다.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
