<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>반품 관리 | 앙사모 ERP</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css?v=20260804-4"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/material.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">RETURN</p><h1>반품 관리</h1><p>불량 입고품의 협력회사 통보, 보완 제작, 재출하 진행 상태를 관리합니다.</p></div></section><c:if test="${not empty success}"><div class="flash success">${success}</div></c:if><c:if test="${not empty error}"><div class="flash error">${error}</div></c:if><section class="panel table-panel"><div class="panel-header"><h2>반품 및 보완 현황</h2><span class="list-count">${returns.size()}건</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>반품</th><th>품목</th><th>협력회사</th><th>수량</th><th>사유</th><th>요청일</th><th>진행 상태</th></tr></thead><tbody><c:forEach items="${returns}" var="row"><tr><td>RT-${row.returnId}</td><td>${row.itemName}</td><td>${row.vendorName}</td><td>${row.returnQty}</td><td>${row.returnReason}</td><td>${row.requestedAt}</td><td><form class="table-form" method="post" action="${pageContext.request.contextPath}/material/returns/status"><input type="hidden" name="returnId" value="${row.returnId}"><select name="status"><option value="REQUESTED" ${row.status == 'REQUESTED' ? 'selected' : ''}>반품 요청</option><option value="RESUPPLYING" ${row.status == 'RESUPPLYING' ? 'selected' : ''}>보완 제작</option><option value="COMPLETED" ${row.status == 'COMPLETED' ? 'selected' : ''}>처리 완료</option></select><button class="action-button" type="submit">저장</button></form></td></tr></c:forEach><c:if test="${empty returns}"><tr><td colspan="7" class="empty-cell">반품 건이 없습니다.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js?v=20260804-5"></script></body></html>
