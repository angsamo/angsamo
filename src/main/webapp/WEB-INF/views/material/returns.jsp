<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>반품 관리 | 앙사모 ERP</title><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/material.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">MT05 · MT06</p><h1>반품·재입고 관리</h1><p>불량 수량과 사유를 등록하고 협력회사 재출하 건을 재검수해 재고에 반영합니다.</p></div></section><c:if test="${not empty success}"><div class="flash success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="flash error"><c:out value="${error}"/></div></c:if><section class="panel table-panel"><div class="panel-header"><h2>반품 및 보완 현황</h2><span class="list-count">${returns.size()}건</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>반품</th><th>품목</th><th>협력회사</th><th>불량 수량</th><th>사유·보완 이력</th><th>진행 상태</th><th>처리</th></tr></thead><tbody>
<c:forEach items="${returns}" var="row"><tr><td>RT-${row.returnId}</td><td><c:out value="${row.itemName}"/></td><td><c:out value="${row.vendorName}"/></td><td>${row.returnQty}</td><td><c:out value="${row.returnReason}"/></td><td><span class="status-badge">${row.status}</span></td><td><c:choose><c:when test="${row.status eq 'RETURNED'}"><form class="table-form" method="post" action="${pageContext.request.contextPath}/material/returns"><input type="hidden" name="returnId" value="${row.returnId}"><input type="number" name="returnQty" min="1" step="1" value="${row.returnQty}" required><input type="text" name="reason" maxlength="500" value="${row.returnReason}" required><button class="action-button" type="submit">반품 요청</button></form></c:when><c:when test="${row.status eq 'SHIPPED'}"><form method="post" action="${pageContext.request.contextPath}/material/returns/${row.returnId}/receive" data-confirm="재출하 수량 전체를 정상 재입고 처리하시겠습니까?"><button class="action-button" type="submit">재입고 검수</button></form></c:when><c:otherwise><span class="hint">협력회사 처리 대기</span></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty returns}"><tr><td colspan="7" class="empty-cell">반품 건이 없습니다.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
