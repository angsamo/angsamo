<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>거래명세서 TS-${statement.statementId}</title>
<style>body{margin:0;color:#172033;font-family:"Noto Sans KR",Arial,sans-serif}.sheet{width:760px;margin:30px auto;padding:42px;border:1px solid #b8c1ce}.sheet h1{text-align:center;letter-spacing:.35em}.meta{display:flex;justify-content:space-between;margin:25px 0}.info{display:grid;grid-template-columns:1fr 1fr;border:1px solid #28384b}.info div{padding:12px;border-right:1px solid #28384b}.info div:last-child{border:0}.info strong{display:block;margin-bottom:7px}.statement-table{width:100%;margin-top:20px;border-collapse:collapse}.statement-table th,.statement-table td{padding:12px;border:1px solid #28384b;text-align:center}.statement-table th{background:#eef3f9}.terms{margin-top:20px;padding:15px;background:#f5f7fa}.actions{display:flex;justify-content:center;margin:24px;gap:8px}.actions button{padding:10px 20px;border:0;border-radius:5px;color:#fff;background:#0c5fc7;font-weight:700}@media print{.actions{display:none}.sheet{margin:0 auto;border:0}}</style></head><body>
<main class="sheet"><h1>거래명세서</h1><div class="meta"><span>명세서 번호: TS-${statement.statementId}</span><span>발행일: ${statement.createdAt}</span></div>
<section class="info"><div><strong>발주회사 정보</strong>${statement.orderCompanyInfo}</div><div><strong>협력회사 정보</strong>${statement.vendorName}<br>${statement.vendorInfo}</div></section>
<table class="statement-table"><thead><tr><th>발주번호</th><th>품목코드</th><th>품목명</th><th>입고수량</th><th>공급가격</th><th>합계금액</th></tr></thead><tbody><tr><td>PO-${statement.poId}</td><td>${statement.itemCode}</td><td>${statement.itemName}</td><td>${statement.qty}</td><td>${statement.supplyPrice}</td><td>${statement.totalPrice}</td></tr></tbody></table>
<div class="terms"><strong>합의 사항</strong><p>${statement.agreedTerms}</p><p>입고 확인: ${statement.inspectedAt}</p></div></main><div class="actions"><button type="button" onclick="window.print()">인쇄</button><button type="button" onclick="window.close()">닫기</button></div>
</body></html>
