<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>거래명세서 | 앙사모 ERP</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css?v=20260804-4"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/material.css"></head><body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">STATEMENT</p><h1>거래명세서</h1><p>정상 입고 수량과 계약 공급가를 기준으로 명세서를 발행하고 협력회사에 통보합니다.</p></div></section><c:if test="${not empty success}"><div class="flash success">${success}</div></c:if><c:if test="${not empty error}"><div class="flash error">${error}</div></c:if><section class="panel table-panel"><div class="panel-header"><h2>발행 대기 입고</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>입고</th><th>발주</th><th>품목</th><th>협력회사</th><th>정상수량</th><th>처리</th></tr></thead><tbody><c:forEach items="${receivings}" var="row"><c:if test="${row.acceptedQty > 0 && empty row.statementId}"><tr><td>R-${row.receivingId}</td><td>PO-${row.poId}</td><td>${row.itemName}</td><td>${row.vendorName}</td><td>${row.acceptedQty}</td><td><form method="post" action="${pageContext.request.contextPath}/material/statements"><input type="hidden" name="receivingId" value="${row.receivingId}"><button class="action-button" type="submit">명세서 발행</button></form></td></tr></c:if></c:forEach></tbody></table></div></section><section class="panel table-panel" style="margin-top:16px"><div class="panel-header"><h2>발행 명세서</h2><span class="list-count">${statements.size()}건</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>명세서</th><th>입고/발주</th><th>품목</th><th>협력회사</th><th>수량</th><th>공급가</th><th>통보</th></tr></thead><tbody><c:forEach items="${statements}" var="row"><tr><td>TS-${row.statementId}</td><td>R-${row.receivingId} / PO-${row.poId}</td><td>${row.itemName}</td><td>${row.vendorName}</td><td>${row.qty}</td><td>${row.supplyPrice}</td><td><c:choose><c:when test="${row.isNotified == 1}"><span class="state-badge enabled">통보 완료</span></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/material/statements/notify"><input type="hidden" name="statementId" value="${row.statementId}"><button class="action-button" type="submit">협력회사 통보</button></form></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty statements}"><tr><td colspan="7" class="empty-cell">발행된 거래명세서가 없습니다.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js?v=20260804-5"></script></body></html>
