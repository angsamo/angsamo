<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="게시판" scope="request"/>
<c:set var="breadcrumb" value="게시판" scope="request"/>
<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>게시판 | ERP</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/common.css"></head>
<body><jsp:include page="/WEB-INF/views/common/sidebar.jsp"/><div class="app-shell"><jsp:include page="/WEB-INF/views/common/header.jsp"/><main class="workspace"><section class="page-heading"><div><p class="eyebrow">BOARD</p><h1>게시판</h1><p>내 부서에서 볼 수 있는 게시판 목록입니다.</p></div></section>
<section class="panel table-panel"><div class="panel-header"><div><p class="eyebrow">BOARD LIST</p><h2>게시판</h2></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>게시판명</th><th>대상</th></tr></thead><tbody>
<c:forEach var="board" items="${boards}"><tr><td><a href="${pageContext.request.contextPath}/boards/${board.boardId}"><c:out value="${board.boardName}"/></a></td><td><c:choose><c:when test="${empty board.departmentId}">전체</c:when><c:otherwise><c:out value="${board.departmentName}"/></c:otherwise></c:choose></td></tr></c:forEach>
<c:if test="${empty boards}"><tr><td class="empty-cell" colspan="2">볼 수 있는 게시판이 없습니다.</td></tr></c:if></tbody></table></div></section></main></div><script src="${pageContext.request.contextPath}/resources/js/common.js"></script></body></html>
