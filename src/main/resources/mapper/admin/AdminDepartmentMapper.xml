<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.angsamo.erp.admin.mapper.AdminDepartmentMapper">
	<select id="findAll" resultType="com.angsamo.erp.admin.dto.DepartmentListItem">
		SELECT
			department_id,
			department_code,
			department_name,
			active,
			created_at,
			updated_at
		FROM department
		ORDER BY department_id
	</select>
</mapper>
